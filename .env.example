# Copy to .env and adjust as needed. All variables are prefixed
# NETPULSE_ per backend/config.py.

NETPULSE_DATABASE_URL=sqlite:///./data/netpulse.db

# Enables /docs, /redoc, and /openapi.json — leave false in production,
# there's no reason to expose the API schema publicly.
NETPULSE_DEBUG=false

NETPULSE_PING_SAMPLES=10
NETPULSE_MAX_DOWNLOAD_BYTES=500000000
NETPULSE_DEFAULT_DOWNLOAD_BYTES=300000000
NETPULSE_UPLOAD_CHUNK_BYTES=4000000
