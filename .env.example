# Copy to .env and adjust as needed. All variables are prefixed
# NETPULSE_ per backend/config.py.

NETPULSE_DATABASE_URL=sqlite:///./data/netpulse.db

NETPULSE_TRAFFIC_POLL_INTERVAL_SEC=5.0

NETPULSE_CONNECTIVITY_TARGETS=["8.8.8.8", "1.1.1.1"]
NETPULSE_CONNECTIVITY_POLL_INTERVAL_SEC=10.0
NETPULSE_PING_TIMEOUT_SEC=1.5

NETPULSE_HIGH_USAGE_THRESHOLD_MB=500.0
NETPULSE_HIGH_USAGE_WINDOW_SEC=60.0
NETPULSE_CONNECTION_DOWN_CONSECUTIVE_FAILURES=3
NETPULSE_HIGH_LATENCY_THRESHOLD_MS=300.0
NETPULSE_HIGH_LATENCY_WINDOW_SAMPLES=5

NETPULSE_ALERTS_ENABLED=false
NETPULSE_TELEGRAM_BOT_TOKEN=
NETPULSE_TELEGRAM_CHAT_ID=
